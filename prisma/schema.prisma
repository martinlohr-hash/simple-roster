generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  DONE
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ASSIGNED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  DIVERSE
}

enum PayrollType {
  SV_PFLICHTIG
  AUSZUBILDENDER
  MINIJOBBER
  WERKSTUDENT
  KURZFRISTIG
  PFLICHTPRAKTIKUM
  GESCHAEFTSFUEHRER
  SONSTIGES
}

enum OtherEmployment {
  NEIN
  JA_SV_PFLICHTIG
  JA_MINIJOB
  JA_KURZFRISTIG
  JA_SELBSTSTAENDIG
}

// Merrill-Reid-Persönlichkeitstyp (siehe "Know Your Team", Unreasonable Hospitality).
// Achsen: extro-/introvertiert × aufgaben-/menschenorientiert.
enum PersonalityType {
  DRIVER      // Extrovertiert + Aufgabenorientiert
  EXPRESSIVE  // Extrovertiert + Menschenorientiert
  AMIABLE     // Introvertiert + Menschenorientiert
  ANALYTIC    // Introvertiert + Aufgabenorientiert
  UNKNOWN     // noch nicht eingeschätzt
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String?
  status            UserStatus  @default(ACTIVE)
  inviteToken       String?     @unique
  inviteTokenExpiry DateTime?
  resetToken        String?     @unique
  resetTokenExpiry  DateTime?
  role              Role        @default(EMPLOYEE)
  hourlyRate        Float       @default(0)
  overheadPercent   Float       @default(0)
  maxHoursWeek      Float?
  maxHoursMonth     Float?
  monthlyRate       Float?
  startDate         DateTime?
  endDate           DateTime?
  phone             String?
  address           String?
  birthday          DateTime?
  vacationDaysPerYear Int       @default(0)
  unavailableDays   Int[]       @default([])  // Wochentage 0=Mo..6=So, an denen nie eingeplant werden soll
  preferredDays     Int[]       @default([])  // Wochentage, die in der Regel gut passen (Wunschtage)
  earliestStart     String?     // "HH:MM" – kann i.d.R. erst ab dieser Uhrzeit
  latestEnd         String?     // "HH:MM" – kann i.d.R. nur bis dieser Uhrzeit
  icalToken         String?     @unique // Geheimer Token für den persönlichen Kalender-Feed (/api/ical/<token>)

  // ---- Personalbogen / Einstellungsbogen ----
  // Gate: null = Stammdaten beim ersten Login noch nicht ausgefüllt → /willkommen erzwingen
  onboardingCompletedAt DateTime?
  // Start der Onboarding-Mail-Sequenz (gesetzt beim ersten Login / Passwort-Setzen). null = noch nicht gestartet.
  onboardingDripStartedAt DateTime?

  // Angaben zum Mitarbeiter (vom MA selbst eingetragen; Geburtsdatum = birthday)
  firstName         String?
  lastName          String?
  street            String?     // Strasse und Hausnummer
  postalCode        String?     // PLZ
  city              String?     // Ort
  nationality       String?     // Staatsangehörigkeit
  birthName         String?     // Geburtsname (falls abweichend)
  birthPlace        String?     // Geburtsort und Land
  gender            Gender?
  taxId             String?     // persönliche Steuer-Identifikationsnummer (11-stellig)
  socialSecurityNo  String?     // Sozialversicherungs-Nr. (12-stellig)
  iban              String?     // Bankverbindung / IBAN
  healthInsurance   String?     // Krankenkasse

  // Angaben zur Beschäftigung (vom Arbeitgeber eingetragen)
  personnelNumber           String?           // Personalnummer
  entryDate                 DateTime?         // Eintritt
  exitDate                  DateTime?         // Austritt (falls bekannt)
  jobTitle                  String?           // genaue Tätigkeitsbezeichnung
  weeklyWorkTime            String?           // Wochenarbeitszeit in Stunden und Tagen (Freitext)
  grossSalary               String?           // Brutto-Verdienst (Lohn/Gehalt oder Stundenlohn, Freitext)
  additionalSalaryComponents String?          // Sonstige Gehaltsbestandteile (VWL/Firmenwagen etc.)
  specialPayments           String?           // Vertraglich festgelegte Sonderzahlungen
  payrollType               PayrollType?      // Abrechnungs-Art
  shortTermLimit            String?           // bei kurzfristiger Beschäftigung: "3 Monate" | "70 Tage"
  voluntaryInternship       Boolean           @default(false) // freiwilliges Praktikum
  shareholderPercent        String?           // Gesellschaftsanteile in % (bei Geschäftsführer)
  otherEmployment           OtherEmployment[] @default([]) // Werden weitere Beschäftigungen ausgeübt? (mehrere möglich)
  vacationDaysAnnual        Float?            // Urlaubsanspruch jährlich
  vacationDaysProRata       Float?            // Urlaubsanspruch lfd. Jahr (anteilig)

  // Dokumente: Link zum Google-Drive-Ordner dieses MA (Originale liegen in Drive)
  documentsUrl              String?

  // Zeitpunkt der letzten an das Lohnbüro versendeten Sofortmeldung (Neuanmeldung)
  sofortmeldungSentAt       DateTime?

  primaryLocationId String?
  primaryLocation   Location?   @relation("PrimaryLocation", fields: [primaryLocationId], references: [id])
  shifts               Shift[]
  timeEntries          TimeEntry[]
  shiftTemplateEntries ShiftTemplateEntry[]
  weekReleases         WeekRelease[]
  shiftApplications    ShiftApplication[]
  vacationRequests     VacationRequest[]    @relation("VacationEmployee")
  reviewedVacations    VacationRequest[]    @relation("VacationReviewer")
  vacationHistory      VacationRequestHistory[] @relation("VacationHistory")
  insight              EmployeeInsight?     @relation("InsightSubject")
  authoredInsights     EmployeeInsight[]    @relation("InsightAuthor")
  onboardingDeliveries OnboardingDelivery[]
  pendingEmails        PendingEmail[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Location {
  id           String      @id @default(cuid())
  name         String
  color        String      @default("#3B82F6")
  sortOrder    Int         @default(0)
  primaryUsers         User[]               @relation("PrimaryLocation")
  shifts               Shift[]
  timeEntries          TimeEntry[]
  shiftTemplateEntries ShiftTemplateEntry[]
  coverageRules        CoverageRule[]
}

model CoverageRule {
  id         String    @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  minStaff   Int       @default(1)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label      String?
  createdAt  DateTime  @default(now())
}

model Shift {
  id         String      @id @default(cuid())
  userId     String?
  locationId String
  date       DateTime
  startTime  String
  endTime    String
  status     ShiftStatus @default(PLANNED)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     Location           @relation(fields: [locationId], references: [id])
  timeEntry    TimeEntry?
  applications ShiftApplication[]
  createdAt    DateTime           @default(now())

  @@index([date])
  @@index([userId, date])
}

model TimeEntry {
  id         String    @id @default(cuid())
  shiftId    String?   @unique
  userId     String
  locationId String
  checkinAt  DateTime
  checkoutAt DateTime?
  shift      Shift?    @relation(fields: [shiftId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location  @relation(fields: [locationId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([checkinAt])
  @@index([userId, checkoutAt])
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

enum BudgetType {
  HOURS
  EUROS
}

model Budget {
  id          String       @id @default(cuid())
  period      BudgetPeriod
  year        Int
  weekOrMonth Int
  type        BudgetType
  amount      Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([period, year, weekOrMonth])
}

model DayNote {
  date    String @id
  content String
}

model ShiftTemplate {
  id        String               @id @default(cuid())
  name      String
  isDefault Boolean              @default(false)
  entries   ShiftTemplateEntry[]
  createdAt DateTime             @default(now())
}

model ShiftTemplateEntry {
  id         String        @id @default(cuid())
  templateId String
  userId     String?
  locationId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  template   ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location      @relation(fields: [locationId], references: [id])
}

model WeekRelease {
  id             String   @id @default(cuid())
  weekStart      DateTime @unique
  releasedAt     DateTime @default(now())
  releasedBy     String
  releasedByUser User     @relation(fields: [releasedBy], references: [id])
}

// Freigabe der echten Tagesstunden für den Sync in die Auswertungs-Tabelle.
// Nur freigegebene Tage werden synchronisiert; `hours` ist der eingefrorene
// Snapshot zum Zeitpunkt der Freigabe (entkoppelt von späteren Korrekturen).
model TimesheetRelease {
  day        String   @id // "yyyy-MM-dd" Berliner Kalendertag
  hours      Float    @default(0)
  entries    Int      @default(0)
  releasedAt DateTime @default(now())
  releasedBy String?
}

model ShiftApplication {
  id        String            @id @default(cuid())
  shiftId   String
  userId    String
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  shift     Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
}

enum BugReportStatus {
  OPEN
  RESOLVED
}

model BugReport {
  id          String          @id @default(cuid())
  area        String
  description String
  status      BugReportStatus @default(OPEN)
  reportedBy  String?
  createdAt   DateTime        @default(now())
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VacationRequest {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("VacationEmployee", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  workdays    Int
  status      VacationStatus @default(PENDING)
  note        String?
  reviewedBy  String?
  reviewer    User?          @relation("VacationReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  history     VacationRequestHistory[]
}

// Audit-Log für Urlaubs-Änderungen (wer hat was wann geändert).
model VacationRequestHistory {
  id            String    @id @default(cuid())
  vacationId    String
  vacation      VacationRequest @relation(fields: [vacationId], references: [id], onDelete: Cascade)
  changedBy     String
  changedByUser User      @relation("VacationHistory", fields: [changedBy], references: [id])
  changeType    String    // "CREATED", "UPDATED", "APPROVED", "REJECTED"
  oldStartDate  DateTime?
  newStartDate  DateTime?
  oldEndDate    DateTime?
  newEndDate    DateTime?
  oldWorkdays   Int?
  newWorkdays   Int?
  oldNote       String?
  newNote       String?
  changedAt     DateTime  @default(now())
}

// Vertrauliche Team-Intelligence-Einschätzung pro Mitarbeiter.
// NUR für SUPER_ADMIN les-/schreibbar (app-seitig erzwungen – die App nutzt
// keine RLS, da Prisma über eine postgres-Rolle mit BYPASSRLS verbindet).
model EmployeeInsight {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation("InsightSubject", fields: [userId], references: [id], onDelete: Cascade)
  personalityType PersonalityType @default(UNKNOWN)
  personalityNote String?         // Mischtyp-/Tendenz-Notiz (app-seitig auf 80 Zeichen begrenzt)
  superpowers     String[]        @default([]) // Stärken (app-seitig auf max. 7 begrenzt)
  observations    String?         // freie Beobachtungen, kein Limit
  assessedAt      DateTime?       // Zeitpunkt der letzten inhaltlichen Einschätzung
  assessedById    String?         // SUPER_ADMIN, der zuletzt einschätzte
  assessedBy      User?           @relation("InsightAuthor", fields: [assessedById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Eine Stufe der Onboarding-Mail-Sequenz (admin-editierbar unter /admin/onboarding).
// delayDays = Versand X Tage nach dem Start (0 = sofort beim ersten Login).
model OnboardingStep {
  id         String   @id @default(cuid())
  order      Int      @default(0)   // Anzeige-/Sortierreihenfolge
  delayDays  Int      @default(0)   // Tage nach Sequenz-Start
  subject    String                 // Betreff der Mail
  body       String                 // Markdown-lite: Absätze, **fett**, [text](url), - Listen, {{vorname}}/{{firma}}
  ctaLabel   String?                // optionaler Button-Text
  ctaUrl     String?                // optionale Button-URL
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deliveries OnboardingDelivery[]
}

// Versand-Protokoll: hält fest, welche Stufe ein MA schon bekommen hat (idempotent).
model OnboardingDelivery {
  id        String         @id @default(cuid())
  userId    String
  stepId    String
  sentAt    DateTime       @default(now())
  status    String         @default("SENT") // SENT | FAILED
  error     String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
}

// Ausstehende E-Mails mit Verzögerung (Debounce für Schicht-Änderungen).
// type="shifts" → mehrere Schicht-Änderungen/Zuweisungen werden gebündelt pro MA.
// type="week_released" → Wochen-Freigabe sofort versendet.
model PendingEmail {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "shifts" | "week_released"
  shiftIds    String[] @default([]) // nur für type="shifts": Schicht-IDs
  metadata    Json?    // { changes: [{ shiftId, action: "assigned"|"changed", oldTime?, newTime?, location? }], weekStart? }
  scheduledFor DateTime // Versand frühestens zu diesem Zeitpunkt
  sentAt      DateTime? // Timestamp wenn versendet
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([scheduledFor, sentAt])
}
