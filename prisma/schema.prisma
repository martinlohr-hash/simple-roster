generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  DONE
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ASSIGNED
  REJECTED
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String?
  status            UserStatus  @default(ACTIVE)
  inviteToken       String?     @unique
  inviteTokenExpiry DateTime?
  role              Role        @default(EMPLOYEE)
  hourlyRate        Float       @default(0)
  overheadPercent   Float       @default(0)
  maxHoursWeek      Float?
  maxHoursMonth     Float?
  monthlyRate       Float?
  startDate         DateTime?
  endDate           DateTime?
  phone             String?
  address           String?
  birthday          DateTime?
  vacationDaysPerYear Int       @default(0)
  unavailableDays   Int[]       @default([])  // Wochentage 0=Mo..6=So, an denen nie eingeplant werden soll
  preferredDays     Int[]       @default([])  // Wochentage, die in der Regel gut passen (Wunschtage)
  earliestStart     String?     // "HH:MM" – kann i.d.R. erst ab dieser Uhrzeit
  latestEnd         String?     // "HH:MM" – kann i.d.R. nur bis dieser Uhrzeit
  primaryLocationId String?
  primaryLocation   Location?   @relation("PrimaryLocation", fields: [primaryLocationId], references: [id])
  shifts               Shift[]
  timeEntries          TimeEntry[]
  shiftTemplateEntries ShiftTemplateEntry[]
  weekReleases         WeekRelease[]
  shiftApplications    ShiftApplication[]
  vacationRequests     VacationRequest[]    @relation("VacationEmployee")
  reviewedVacations    VacationRequest[]    @relation("VacationReviewer")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Location {
  id           String      @id @default(cuid())
  name         String
  color        String      @default("#3B82F6")
  sortOrder    Int         @default(0)
  primaryUsers         User[]               @relation("PrimaryLocation")
  shifts               Shift[]
  timeEntries          TimeEntry[]
  shiftTemplateEntries ShiftTemplateEntry[]
  coverageRules        CoverageRule[]
}

model CoverageRule {
  id         String    @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  minStaff   Int       @default(1)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label      String?
  createdAt  DateTime  @default(now())
}

model Shift {
  id         String      @id @default(cuid())
  userId     String?
  locationId String
  date       DateTime
  startTime  String
  endTime    String
  status     ShiftStatus @default(PLANNED)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     Location           @relation(fields: [locationId], references: [id])
  timeEntry    TimeEntry?
  applications ShiftApplication[]
  createdAt    DateTime           @default(now())
}

model TimeEntry {
  id         String    @id @default(cuid())
  shiftId    String?   @unique
  userId     String
  locationId String
  checkinAt  DateTime
  checkoutAt DateTime?
  shift      Shift?    @relation(fields: [shiftId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location  @relation(fields: [locationId], references: [id])
  createdAt  DateTime  @default(now())
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

enum BudgetType {
  HOURS
  EUROS
}

model Budget {
  id          String       @id @default(cuid())
  period      BudgetPeriod
  year        Int
  weekOrMonth Int
  type        BudgetType
  amount      Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([period, year, weekOrMonth])
}

model DayNote {
  date    String @id
  content String
}

model ShiftTemplate {
  id        String               @id @default(cuid())
  name      String
  isDefault Boolean              @default(false)
  entries   ShiftTemplateEntry[]
  createdAt DateTime             @default(now())
}

model ShiftTemplateEntry {
  id         String        @id @default(cuid())
  templateId String
  userId     String?
  locationId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  template   ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location      @relation(fields: [locationId], references: [id])
}

model WeekRelease {
  id             String   @id @default(cuid())
  weekStart      DateTime @unique
  releasedAt     DateTime @default(now())
  releasedBy     String
  releasedByUser User     @relation(fields: [releasedBy], references: [id])
}

model ShiftApplication {
  id        String            @id @default(cuid())
  shiftId   String
  userId    String
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  shift     Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
}

enum BugReportStatus {
  OPEN
  RESOLVED
}

model BugReport {
  id          String          @id @default(cuid())
  area        String
  description String
  status      BugReportStatus @default(OPEN)
  reportedBy  String?
  createdAt   DateTime        @default(now())
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VacationRequest {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("VacationEmployee", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  workdays    Int
  status      VacationStatus @default(PENDING)
  note        String?
  reviewedBy  String?
  reviewer    User?          @relation("VacationReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
}
